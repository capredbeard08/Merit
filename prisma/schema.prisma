generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  AGENT
  VIEWER
}

enum PlatformAccessRole {
  FOUNDER_SUPER_ADMIN
  PLATFORM_ADMIN
  ENGINEER
}

enum SupportAccessScope {
  CUSTOMER_RECORDS_READ
  FEEDBACK_READ
  FEEDBACK_REPLIES_READ
  FILE_ASSETS_READ
}

enum SupportAccessStatus {
  PENDING
  APPROVED
  DENIED
  REVOKED
  EXPIRED
}

enum FeedbackStatus {
  PENDING
  CONTACTED
  CLICKED
  REPLIED
  RESOLVED
  OPTED_OUT
}

model Workspace {
  id        String    @id @default(cuid())
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  members   Member[]
  branches  Branch[]
  customers Customer[]
  feedback  Feedback[]
  events    ServiceEvent[]
  webhookEndpoints WebhookEndpoint[]
  invitations Invitation[]
  followUps FollowUp[]
  replies FeedbackReply[]
  insights Insight[]
  auditLogs AuditLog[]
  files FileAsset[]
  supportAccessRequests SupportAccessRequest[]
}

model Member {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  email       String
  role        Role      @default(VIEWER)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([workspaceId, email])
  @@unique([workspaceId, userId])
  @@index([workspaceId, role])
}

model Branch {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  externalId  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  archivedAt  DateTime?
  archivedById String?
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customers   Customer[]
  feedback    Feedback[]
  events      ServiceEvent[]
  webhooks    WebhookEndpoint[]
  @@unique([workspaceId, externalId])
  @@index([workspaceId])
  @@index([workspaceId, archivedAt])
}

model Customer {
  id           String     @id @default(cuid())
  workspaceId  String
  branchId     String?
  externalId   String
  name         String?
  email        String?
  phone        String?
  consentAt    DateTime?
  optedOutAt   DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  workspace    Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  branch       Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  feedback     Feedback[]
  events       ServiceEvent[]
  @@unique([workspaceId, externalId])
  @@index([workspaceId, email])
}

model ServiceEvent {
  id           String   @id @default(cuid())
  workspaceId  String
  branchId     String
  customerId   String
  externalId   String?
  type         String?
  completedAt  DateTime
  receivedAt   DateTime @default(now())
  payloadHash  String?
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  branch       Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  feedback     Feedback?
  @@unique([workspaceId, externalId])
  @@index([workspaceId, branchId, completedAt])
  @@index([customerId, completedAt])
}

model Feedback {
  id             String         @id @default(cuid())
  workspaceId    String
  branchId       String
  customerId     String
  serviceEventId String         @unique
  status         FeedbackStatus @default(PENDING)
  sentAt         DateTime?
  clickedAt      DateTime?
  repliedAt      DateTime?
  followUp       FollowUp?
  replies        FeedbackReply[]
  resolvedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  branch         Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customer       Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  serviceEvent   ServiceEvent   @relation(fields: [serviceEventId], references: [id], onDelete: Cascade)
  @@index([workspaceId, status, createdAt])
  @@index([branchId, createdAt])
  @@index([customerId, createdAt])
}

model Invitation {
  id             String   @id @default(cuid())
  workspaceId    String
  email          String
  role           Role     @default(VIEWER)
  tokenHash      String   @unique
  expiresAt      DateTime
  invitedByUserId String
  acceptedAt     DateTime?
  createdAt      DateTime @default(now())
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@index([workspaceId, email])
  @@index([expiresAt])
}

model WebhookEndpoint {
  id          String    @id @default(cuid())
  workspaceId String
  label       String
  secretHash  String
  branchId    String?
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  branch      Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  @@index([workspaceId, revokedAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String
  actorUserId String?
  action      String
  targetType  String
  targetId    String?
  metadata   Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@index([workspaceId, createdAt])
  @@index([workspaceId, action, createdAt])
  @@index([targetType, targetId])
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  twoFactorEnabled Boolean @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  twoFactor     TwoFactor?
  members       Member[]
  platformAccess PlatformAccess? @relation("PlatformAccessSubject")
  platformAccessGrants PlatformAccess[] @relation("PlatformAccessGrantor")
  supportAccessRequestsMade SupportAccessRequest[] @relation("SupportAccessRequester")
  supportAccessDecisions SupportAccessRequest[] @relation("SupportAccessDecider")
  supportAccessRevocations SupportAccessRequest[] @relation("SupportAccessRevoker")
}


/// Better Auth TOTP authenticator and one-time backup-code storage.
model TwoFactor {
  id                     String   @id
  userId                 String   @unique
  secret                 String
  backupCodes            String
  verified               Boolean  @default(false)
  failedVerificationCount Int     @default(0)
  lockedUntil            DateTime?
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Platform identity and privileges are separate from workspace Member roles.
/// This record grants platform-console capabilities only; it never grants
/// access to customer feedback, replies, files, or other workspace content.
model PlatformAccess {
  id              String            @id @default(cuid())
  userId          String            @unique
  role            PlatformAccessRole
  grantedByUserId String?
  revokedAt       DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  user            User              @relation("PlatformAccessSubject", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy       User?             @relation("PlatformAccessGrantor", fields: [grantedByUserId], references: [id], onDelete: SetNull)
  @@index([role, revokedAt])
}

/// Business-approved, read-only, time-limited support access.
/// This grant is a gate for future support data routes; it does not itself expose data.
model SupportAccessRequest {
  id                      String              @id @default(cuid())
  workspaceId             String
  requestedByUserId       String
  decidedByUserId         String?
  revokedByUserId         String?
  scope                   SupportAccessScope
  status                  SupportAccessStatus @default(PENDING)
  reason                  String              @db.VarChar(500)
  requestedDurationMinutes Int
  requestExpiresAt        DateTime
  decidedAt               DateTime?
  expiresAt               DateTime?
  revokedAt               DateTime?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  workspace               Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  requestedBy             User                @relation("SupportAccessRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  decidedBy               User?               @relation("SupportAccessDecider", fields: [decidedByUserId], references: [id], onDelete: SetNull)
  revokedBy               User?               @relation("SupportAccessRevoker", fields: [revokedByUserId], references: [id], onDelete: SetNull)
  @@index([workspaceId, status, createdAt])
  @@index([requestedByUserId, status, createdAt])
  @@index([status, requestExpiresAt])
  @@index([status, expiresAt])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Account {
  id                   String    @id
  accountId            String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime
  updatedAt  DateTime
  @@index([identifier])
  @@index([value])
}

enum FollowUpStatus {
  QUEUED
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

model FollowUp {
  id          String         @id @default(cuid())
  workspaceId String
  feedbackId  String         @unique
  channel     String         @default("email")
  status      FollowUpStatus @default(QUEUED)
  scheduledAt DateTime
  processingAt DateTime?
  firstAttemptAt DateTime?
  sentAt      DateTime?
  failedAt    DateTime?
  providerId  String?
  error       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  feedback    Feedback       @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  @@index([workspaceId, status, scheduledAt])
  @@index([status, processingAt])
}

enum FeedbackRating {
  ONE
  TWO
  THREE
  FOUR
  FIVE
}

model FeedbackReply {
  id          String         @id @default(cuid())
  workspaceId String
  feedbackId  String
  rating      FeedbackRating?
  message     String?
  email       String?
  createdAt   DateTime       @default(now())
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  feedback    Feedback       @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  @@index([workspaceId, createdAt])
  @@index([feedbackId, createdAt])
}

model Insight {
  id          String   @id @default(cuid())
  workspaceId String
  kind        String
  title       String
  summary     String
  evidence    Json
  createdAt   DateTime @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@index([workspaceId, createdAt])
}

model FileAsset {
  id           String   @id @default(cuid())
  workspaceId  String
  uploadedById String
  originalName String
  pathname     String   @unique
  contentType  String
  sizeBytes    Int
  status       String   @default("AVAILABLE")
  analysisText String?
  deletedAt    DateTime?
  deletedById  String?
  priorStatus  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@index([workspaceId, createdAt])
  @@index([workspaceId, deletedAt])
}


/// Fixed-window, database-backed limiter for privileged platform actions.
/// Keys are HMAC digests; raw user identifiers are never stored here.
model RateLimitBucket {
  id              String   @id
  key             String   @unique
  windowStartedAt DateTime
  count           Int
  expiresAt       DateTime
  @@index([expiresAt])
}

model SecurityEvent {
  id          String   @id @default(cuid())
  workspaceId String?
  actorUserId String?
  type        String
  severity    String
  targetId    String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  @@index([workspaceId, createdAt])
  @@index([severity, createdAt])
  @@index([type, createdAt])
}
