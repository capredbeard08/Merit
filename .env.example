DATABASE_URL="postgresql://MIGRATION_OWNER:PASSWORD@HOST:5432/merit?sslmode=require"
# Restricted app role; must not own tables, be superuser, or have BYPASSRLS.
# Required before using withTenantDb; never reuse the migration-owner URL.
DATABASE_RUNTIME_URL=""
AUTH_SECRET="replace-with-a-long-random-secret"
AI_PROVIDER_API_KEY=""
EMAIL_PROVIDER_API_KEY=""

# Better Auth
BETTER_AUTH_URL=http://localhost:3000

NEXT_PUBLIC_APP_URL=http://localhost:3000

EMAIL_FROM="MERIT <hello@example.com>"
CRON_SECRET="replace-with-long-random-secret"

# Set only after approving MERIT's file-recovery retention policy (1-3650 days).
# Permanent file erasure stays disabled when this value is unset.
FILE_RECOVERY_RETENTION_DAYS=
