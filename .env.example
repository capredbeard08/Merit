DATABASE_URL="postgresql://MIGRATION_OWNER:PASSWORD@HOST:5432/merit?sslmode=require"
# Reserved for a future provider that supports a genuinely restricted PostgreSQL role.
# Current Prisma Postgres does not support this role model: leave unset and do not wire withTenantDb.
# A second URL using the same unrestricted credentials does NOT provide RLS isolation.
DATABASE_RUNTIME_URL=""
AUTH_SECRET="replace-with-a-long-random-secret"
# Optional dedicated HMAC key for public feedback capabilities. If unset, AUTH_SECRET is used.
# Keep previous keys here during rotation (comma-separated); verification only, never used to issue new tokens.
FEEDBACK_TOKEN_SECRET=""
FEEDBACK_TOKEN_PREVIOUS_SECRETS=""
AI_PROVIDER_API_KEY=""
EMAIL_PROVIDER_API_KEY=""

# Better Auth
BETTER_AUTH_URL=http://localhost:3000

NEXT_PUBLIC_APP_URL=http://localhost:3000

EMAIL_FROM="MERIT <hello@example.com>"
CRON_SECRET="replace-with-long-random-secret"

# Set only after approving MERIT's file-recovery retention policy (1-3650 days).
# Permanent file erasure stays disabled when this value is unset.
FILE_RECOVERY_RETENTION_DAYS=
