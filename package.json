{
  "name": "merit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "test:security": "tsx --test src/lib/security-warden.test.ts src/lib/security-warden-policy.test.ts src/lib/file-security.test.ts src/lib/domain.test.ts src/lib/workspace-access.test.ts src/lib/platform-access.test.ts src/lib/founder-bootstrap.test.ts src/lib/platform-security-events.test.ts src/lib/support-access.test.ts src/lib/support-access-decision.test.ts src/lib/email.test.ts src/lib/guest-feedback.test.ts",
    "test:integration": "tsx --test src/lib/support-access.integration.test.ts src/lib/guest-feedback.integration.test.ts"
  },
  "dependencies": {
    "next": "15.5.18",
    "react": "19.1.7",
    "react-dom": "19.1.7",
    "zod": "4.0.0",
    "better-auth": "1.7.8",
    "@better-auth/prisma-adapter": "1.7.8",
    "@prisma/client": "6.19.3",
    "@vercel/blob": "^2.3.0"
  },
  "devDependencies": {
    "@types/node": "22.10.0",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "typescript": "5.7.2",
    "tailwindcss": "4.1.0",
    "@tailwindcss/postcss": "4.1.0",
    "prisma": "6.19.3",
    "tsx": "4.19.2"
  }
}
